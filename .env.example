# Alle LLM-Aufrufe (Naive-LLM, RAG-LLM, RAGAS-Evaluation, AI-Risk-Analyse) laufen über OpenRouter.
OPENROUTER_API_KEY=

# SEC EDGAR verlangt bei jeder Anfrage einen identifizierenden User-Agent (Name + E-Mail).
SEC_USER_AGENT=Your Name your.email@example.com

# Kostenloser Key: https://www.alphavantage.co/support/#api-key (~20 Sekunden, kein Kreditkarte).
# Ohne Key bleibt AlphaVantageNewsSource automatisch inaktiv (kein Fehler).
ALPHAVANTAGE_API_KEY=
